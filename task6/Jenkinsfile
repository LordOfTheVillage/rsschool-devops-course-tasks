pipeline {
    agent {
        kubernetes {
            yamlFile 'task6/jenkins-agent.yaml'
        }
    }

    environment {
        APP_NAME = 'flask-app'
        APP_VERSION = "1.0.${BUILD_NUMBER}"
        DOCKER_IMAGE = "10.110.122.152:80/flask-app:${BUILD_NUMBER}"
        APP_DIR = 'task6/flask_app'
        HELM_CHART_PATH = 'task6/flask-app-chart'
        
        // SonarQube settings
        SONAR_PROJECT_KEY = 'lordofthevillage_rsschool-devops-course-tasks'
        SONAR_PROJECT_NAME = 'rsschool-devops-course-tasks'
        SONAR_ORGANIZATION = 'lordofthevillage'
        
        // Telegram credentials
        TELEGRAM_BOT_TOKEN = credentials('TELEGRAM_BOT_TOKEN')
        TELEGRAM_CHAT_ID = credentials('TELEGRAM_CHAT_ID')
    }

    stages {
        stage('🚀 Checkout') {
            steps {
                container('jnlp') {
                    echo "🔍 Starting CI/CD Pipeline for ${APP_NAME} v${APP_VERSION}"
                    checkout scm
                    sh '''
                        echo "📋 Git Information:"
                        echo "Branch: $(git rev-parse --abbrev-ref HEAD)"
                        echo "Commit: $(git rev-parse --short HEAD)"
                        echo "Author: $(git log -1 --pretty=format:'%an <%ae>')"
                    '''
                }
            }
        }

        stage('🔐 SonarQube Analysis') {
            steps {
                container('sonar') {
                    echo "🔐 Running SonarQube Cloud analysis..."
                    dir("${APP_DIR}") {
                        sh '''
                            sonar-scanner \\
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \\
                                -Dsonar.organization=${SONAR_ORGANIZATION} \\
                                -Dsonar.projectName="${SONAR_PROJECT_NAME}" \\
                                -Dsonar.projectVersion=${APP_VERSION} \\
                                -Dsonar.sources=. \\
                                -Dsonar.python.coverage.reportPaths=coverage.xml \\
                                -Dsonar.exclusions=venv/**,__pycache__/**,*.pyc
                        '''
                    }
                }
            }
        }

        stage('🧪 Run Tests') {
            steps {
                container('python') {
                    echo "🧪 Running tests with coverage..."
                    dir("${APP_DIR}") {
                        sh '''
                            echo "📦 Installing dependencies..."
                            pip install -r requirements.txt
                            pip install pytest coverage
                            
                            echo "🔍 Running tests..."
                            coverage run -m pytest --junitxml=report.xml --verbose
                            coverage xml -o coverage.xml
                            coverage report
                        '''
                        
                        publishHTML([
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: '.',
                            reportFiles: 'coverage.xml',
                            reportName: 'Coverage Report'
                        ])
                    }
                }
            }
        }

        stage('🐳 Build Docker Image') {
            steps {
                container('docker') {
                    echo "🐳 Building Docker image..."
                    dir("${APP_DIR}") {
                        sh """
                            echo "🔨 Building image: ${DOCKER_IMAGE}"
                            docker build -t ${DOCKER_IMAGE} .
                        """
                    }
                }
            }
        }

        stage('📤 Push Docker Image') {
            steps {
                container('docker') {
                    echo "📤 Pushing Docker image to registry..."
                    sh """
                        echo "🚀 Pushing ${DOCKER_IMAGE} to local registry"
                        docker push ${DOCKER_IMAGE}
                    """
                }
            }
            post {
                always {
                    container('docker') {
                        sh "docker rmi ${DOCKER_IMAGE} || true"
                    }
                }
            }
        }

        stage('🚀 Deploy with Helm') {
            when {
                anyOf {
                    branch 'main'
                    branch 'task_6'
                    expression { params.FORCE_DEPLOY == true }
                }
            }
            steps {
                container('helm') {
                    echo "🚀 Deploying with Helm..."
                    sh """
                        helm upgrade --install ${APP_NAME} ${HELM_CHART_PATH} \\
                            --namespace default \\
                            --set image.repository=10.110.122.152:80/flask-app \\
                            --set image.tag=${BUILD_NUMBER} \\
                            --wait --timeout=300s
                        
                        echo "✅ Deployment completed!"
                        kubectl get pods -l app.kubernetes.io/name=flask-app-chart
                    """
                }
            }
        }

        stage('✅ Health Check') {
            when {
                anyOf {
                    branch 'main'
                    branch 'task_6'
                    expression { params.FORCE_DEPLOY == true }
                }
            }
            steps {
                container('jnlp') {
                    echo "✅ Performing health check..."
                    sh '''
                        sleep 30
                        echo "🏥 Application deployed successfully!"
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                echo "🎉 Pipeline completed successfully!"
                sh """
                    curl -s -X POST https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage \\
                        -d chat_id=${TELEGRAM_CHAT_ID} \\
                        -d parse_mode=Markdown \\
                        -d text='✅ *Jenkins Pipeline SUCCESS* 
📦 *Application:* ${APP_NAME} v${APP_VERSION}
🌿 *Branch:* ${env.BRANCH_NAME}
🔗 *Build:* [#${env.BUILD_NUMBER}](${env.BUILD_URL})
⏱️ *Duration:* ${currentBuild.durationString}
👤 *Triggered by:* ${env.BUILD_USER ?: 'Jenkins'}'
                """
            }
        }
        
        failure {
            script {
                echo "❌ Pipeline failed!"
                sh """
                    curl -s -X POST https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage \\
                        -d chat_id=${TELEGRAM_CHAT_ID} \\
                        -d parse_mode=Markdown \\
                        -d text='❌ *Jenkins Pipeline FAILED* 
📦 *Application:* ${APP_NAME} v${APP_VERSION}
🌿 *Branch:* ${env.BRANCH_NAME}
🔗 *Build:* [#${env.BUILD_NUMBER}](${env.BUILD_URL})
⏱️ *Duration:* ${currentBuild.durationString}
🔍 *Check logs:* [Console Output](${env.BUILD_URL}console)'
                """
            }
        }
        
        unstable {
            script {
                echo "⚠️ Pipeline unstable!"
                sh """
                    curl -s -X POST https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage \\
                        -d chat_id=${TELEGRAM_CHAT_ID} \\
                        -d parse_mode=Markdown \\
                        -d text='⚠️ *Jenkins Pipeline UNSTABLE* 
📦 *Application:* ${APP_NAME} v${APP_VERSION}
🌿 *Branch:* ${env.BRANCH_NAME}
🔗 *Build:* [#${env.BUILD_NUMBER}](${env.BUILD_URL})
🔍 *Some tests may have failed*'
                """
            }
        }
        
        always {
            echo "🧹 Cleaning up workspace..."
        }
    }
}

parameters {
    booleanParam(
        name: 'FORCE_DEPLOY',
        defaultValue: false,
        description: 'Force deployment regardless of branch'
    )
} 